# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.vitest/
**/.tmp-test-backups/
# Frontend E2E artifacts
**/test-results/
**/playwright-report/
**/.playwright/

# Backup artifacts (never commit PHI-bearing dumps)
backups/
**/backups/
*.dump
*.dump.enc

# Installer / operational runtime state (never commit).
# NOTE: these match ROOT-level runtime dirs only, never the source module
# server/src/license/ (that is application code and MUST be committed).
install/logs/
install/medcore.pid
/state/
/license/
vendor-keys/
*.pem
