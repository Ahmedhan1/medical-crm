# MEDCORE server configuration.
# Copy to `.env` and adjust. Never commit a real `.env`.

# --- Runtime ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# --- Database (local-first: Postgres runs on the MEDCORE box / LAN server) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medcore
# Used only by the test runner:
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/medcore_test

# --- Security ---
# Server-side pepper mixed into password hashing. Generate a long random value
# per deployment and store it in the secret manager, NOT in the database.
# Rotating this invalidates existing password hashes (users must reset).
AUTH_PEPPER=change-me-to-a-long-random-secret-per-deployment

# Session lifetime in seconds (default 12h — a clinic working day).
SESSION_TTL_SECONDS=43200

# QR identity token lifetime in seconds (default 24h). QR tokens carry NO PHI;
# they are opaque references resolved server-side under authorization.
QR_TTL_SECONDS=86400

# --- Auth throttling / brute-force protection ---
# Per-account lockout + per-IP login rate limit (in-memory, single-box).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_MAX_PER_MINUTE=30

# --- Backup / recovery (Phase 2) ---
# Directory the backup engine writes to (a path on the MEDCORE box or a mounted
# external/encrypted volume). Never exposed through any API.
BACKUP_DIR=./backups
# Optional at-rest encryption. When set (>=32 chars), dumps are AES-256-GCM
# encrypted. Store in the secret manager — NEVER in the DB or a backup artifact.
# BACKUP_ENCRYPTION_KEY=change-me-to-a-long-random-backup-encryption-secret
# Retention (GFS rotation) targets.
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_RETAIN_MONTHLY=3

# --- Arabic / RTL PDF (Phase 3, optional platform capability) ---
# Path to the Chromium executable used by the Arabic/RTL PDF renderer. Optional:
# if unset, playwright-core's managed browser (PLAYWRIGHT_BROWSERS_PATH) is used,
# falling back to a scan of that directory. Only needed to pin a specific binary.
# PDF_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome-linux/chrome
